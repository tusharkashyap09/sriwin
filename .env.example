# Set these variables in the PHP runtime environment; this file is a reference only.
SRIWIN_DB_HOST=localhost
SRIWIN_DB_USERNAME=
SRIWIN_DB_PASSWORD=
SRIWIN_DB_NAME=

# Required by conn.php encryption and demouser.php JWT generation when those
# features are used. Keep the existing production values private and rotate
# them if they have been exposed.
SRIWIN_ENCRYPTION_KEY=
SRIWIN_ENCRYPTION_IV=
SRIWIN_JWT_SECRET=
